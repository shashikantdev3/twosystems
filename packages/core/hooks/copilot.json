        "powershell": "twosystems hook --agent copilot --event PreCompact",
        "timeout": 15,
        "timeoutSec": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "twosystems hook --agent copilot --event Stop",
        "bash": "twosystems hook --agent copilot --event Stop",
        "powershell": "twosystems hook --agent copilot --event Stop",
        "timeout": 15,
        "timeoutSec": 15
