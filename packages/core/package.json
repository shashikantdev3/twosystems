{
  "name": "twosystems",
  "version": "0.1.0-alpha.2",
  "description": "A cheap, honest watchman for AI coding agents (Claude Code, GitHub Copilot, Codex): notices when the agent is stuck or a fresh start would save tokens, using a small decision model, and measures what it saved. Created by Shashikant.",
  "keywords": [
    "claude-code",
    "github-copilot",
    "codex",
    "ai-agents",
    "coding-agents",
    "agent-hooks",
    "token-optimization",
    "llm-cost",
    "decision-models",
    "system-1",
    "guardrails",
    "calibration"
  ],
  "homepage": "https://github.com/shashikantdev3/twosystems#readme",
  "bugs": {
    "url": "https://github.com/shashikantdev3/twosystems/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashikantdev3/twosystems.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Shashikant (https://github.com/shashikantdev3)",
  "type": "module",
  "bin": {
    "twosystems": "bin/twosystems.js"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist/src",
    "hooks",
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Shashikant (https://github.com/shashikantdev3)"
  ]
}
